# Copy to .env before running docker compose. Never commit .env.
POSTGRES_DB=settlement_hub
POSTGRES_USER=settlement
POSTGRES_PASSWORD=settlement

# Must be at least 32 bytes.
APP_JWT_SECRET=change-me-local-jwt-secret-at-least-32-bytes

# Used once at startup to create the admin account. Change before use.
APP_ADMIN_PASSWORD=change-me-local-admin-password
